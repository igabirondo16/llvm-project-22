; RUN: opt -mtriple=riscv32 -mattr=+m,+xrepeat -passes="print<cost-model>" \
; RUN:   -disable-output < %s 2>&1 | FileCheck %s

; XRepeat (VRF core): an operation on a whole 8- or 16-wide block of F
; registers is one instruction + REPEAT (cost 2). What the core can't do in one
; burst has an invalid throughput cost, so the vectorizers don't choose it:
; shuffles other than splats, conversions, compares, divisions, vectors that
; aren't whole blocks, and 16-wide operations reading two vectors plus a third
; register (mul of two vectors, which needs a zero addend; fma). A 16-wide
; fmuladd is an fmul and an fadd.

define void @vrf(ptr %p, i32 %s, float %f) {
; CHECK-LABEL: 'vrf'
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %a = load <8 x i32>, ptr %p, align 32
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %b = load <8 x float>, ptr %p, align 32
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %c = load <16 x i32>, ptr %p, align 64
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %d = load <16 x float>, ptr %p, align 64
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %add = add <8 x i32> %a, %a
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %shl = shl <16 x i32> %c, %c
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %mul8 = mul <8 x i32> %a, %a
; CHECK-NEXT:  Cost Model: Found an estimated cost of 64 for instruction: %mul = mul <16 x i32> %c, %c
; CHECK-NEXT:  Cost Model: Found an estimated cost of 1 for instruction: %hs = insertelement <16 x i32> poison, i32 %s, i32 0
; CHECK-NEXT:  Cost Model: Found an estimated cost of 1 for instruction: %splats = shufflevector <16 x i32> %hs, <16 x i32> poison, <16 x i32> zeroinitializer
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %mulsplat = mul <16 x i32> %c, %splats
; CHECK-NEXT:  Cost Model: Invalid cost for instruction: %div = sdiv <8 x i32> %a, %a
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %fadd = fadd <8 x float> %b, %b
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %fmul = fmul <16 x float> %d, %d
; CHECK-NEXT:  Cost Model: Invalid cost for instruction: %fdiv = fdiv <8 x float> %b, %b
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %fma8 = call <8 x float> @llvm.fmuladd.v8f32(<8 x float> %b, <8 x float> %b, <8 x float> %b)
; CHECK-NEXT:  Cost Model: Found an estimated cost of 4 for instruction: %fma = call <16 x float> @llvm.fmuladd.v16f32(<16 x float> %d, <16 x float> %d, <16 x float> %d)
; CHECK-NEXT:  Cost Model: Found an estimated cost of 1 for instruction: %e1 = extractelement <8 x i32> %a, i32 3
; CHECK-NEXT:  Cost Model: Found an estimated cost of 1 for instruction: %e2 = extractelement <16 x float> %d, i32 %s
; CHECK-NEXT:  Cost Model: Found an estimated cost of 1 for instruction: %i1 = insertelement <8 x float> %b, float %f, i32 0
; CHECK-NEXT:  Cost Model: Found an estimated cost of 1 for instruction: %splat = shufflevector <8 x i32> %a, <8 x i32> poison, <8 x i32> zeroinitializer
; CHECK-NEXT:  Cost Model: Invalid cost for instruction: %rev = shufflevector <16 x float> %d, <16 x float> poison, <16 x i32> <i32 15, i32 14, i32 13, i32 12, i32 11, i32 10, i32 9, i32 8, i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
; CHECK-NEXT:  Cost Model: Invalid cost for instruction: %cvt = sitofp <8 x i32> %a to <8 x float>
; CHECK-NEXT:  Cost Model: Invalid cost for instruction: %cmp = icmp slt <8 x i32> %a, %a
; CHECK-NEXT:  Cost Model: Found an estimated cost of 0 for instruction: %bc = bitcast <16 x i32> %c to <16 x float>
; CHECK-NEXT:  Cost Model: Found an estimated cost of 4 for instruction: %red = call i32 @llvm.vector.reduce.add.v8i32(<8 x i32> %a)
; CHECK-NEXT:  Cost Model: Found an estimated cost of 4 for instruction: %fred = call float @llvm.vector.reduce.fadd.v16f32(float %f, <16 x float> %d)
; CHECK-NEXT:  Cost Model: Invalid cost for instruction: %redmul = call i32 @llvm.vector.reduce.mul.v8i32(<8 x i32> %a)
; CHECK-NEXT:  Cost Model: Invalid cost for instruction: %q = load <4 x i32>, ptr %p, align 16
; CHECK-NEXT:  Cost Model: Invalid cost for instruction: %qadd = add <4 x i32> %q, %q
; CHECK-NEXT:  Cost Model: Found an estimated cost of 4 for instruction: %w = load <32 x i32>, ptr %p, align 128
; CHECK-NEXT:  Cost Model: Found an estimated cost of 4 for instruction: %wadd = add <32 x i32> %w, %w
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: store <8 x i32> %add, ptr %p, align 32
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: store <16 x float> %fma, ptr %p, align 64
; CHECK-NEXT:  Cost Model: Found an estimated cost of 0 for instruction: ret void
;
  %a = load <8 x i32>, ptr %p
  %b = load <8 x float>, ptr %p
  %c = load <16 x i32>, ptr %p
  %d = load <16 x float>, ptr %p
  %add = add <8 x i32> %a, %a
  %shl = shl <16 x i32> %c, %c
  %mul8 = mul <8 x i32> %a, %a
  %mul = mul <16 x i32> %c, %c
  %hs = insertelement <16 x i32> poison, i32 %s, i32 0
  %splats = shufflevector <16 x i32> %hs, <16 x i32> poison, <16 x i32> zeroinitializer
  %mulsplat = mul <16 x i32> %c, %splats
  %div = sdiv <8 x i32> %a, %a
  %fadd = fadd <8 x float> %b, %b
  %fmul = fmul <16 x float> %d, %d
  %fdiv = fdiv <8 x float> %b, %b
  %fma8 = call <8 x float> @llvm.fmuladd.v8f32(<8 x float> %b, <8 x float> %b, <8 x float> %b)
  %fma = call <16 x float> @llvm.fmuladd.v16f32(<16 x float> %d, <16 x float> %d, <16 x float> %d)
  %e1 = extractelement <8 x i32> %a, i32 3
  %e2 = extractelement <16 x float> %d, i32 %s
  %i1 = insertelement <8 x float> %b, float %f, i32 0
  %splat = shufflevector <8 x i32> %a, <8 x i32> poison, <8 x i32> zeroinitializer
  %rev = shufflevector <16 x float> %d, <16 x float> poison, <16 x i32> <i32 15, i32 14, i32 13, i32 12, i32 11, i32 10, i32 9, i32 8, i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
  %cvt = sitofp <8 x i32> %a to <8 x float>
  %cmp = icmp slt <8 x i32> %a, %a
  %bc = bitcast <16 x i32> %c to <16 x float>
  %red = call i32 @llvm.vector.reduce.add.v8i32(<8 x i32> %a)
  %fred = call float @llvm.vector.reduce.fadd.v16f32(float %f, <16 x float> %d)
  %redmul = call i32 @llvm.vector.reduce.mul.v8i32(<8 x i32> %a)
  %q = load <4 x i32>, ptr %p
  %qadd = add <4 x i32> %q, %q
  %w = load <32 x i32>, ptr %p
  %wadd = add <32 x i32> %w, %w
  store <8 x i32> %add, ptr %p
  store <16 x float> %fma, ptr %p
  ret void
}

; Strided loads and stores (flw/fsw + REPEAT with the stride register) cost
; as much as contiguous ones; not a whole block is invalid.
define void @strided(ptr %p, i32 %s) {
; CHECK-LABEL: 'strided'
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %l8 = call <8 x i32> @llvm.experimental.vp.strided.load.v8i32.p0.i32(ptr align 4 %p, i32 %s, <8 x i1> splat (i1 true), i32 8)
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: %l16f = call <16 x float> @llvm.experimental.vp.strided.load.v16f32.p0.i32(ptr align 4 %p, i32 %s, <16 x i1> splat (i1 true), i32 16)
; CHECK-NEXT:  Cost Model: Invalid cost for instruction: %l4 = call <4 x i32> @llvm.experimental.vp.strided.load.v4i32.p0.i32(ptr align 4 %p, i32 %s, <4 x i1> splat (i1 true), i32 4)
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: call void @llvm.experimental.vp.strided.store.v8i32.p0.i32(<8 x i32> %l8, ptr align 4 %p, i32 %s, <8 x i1> splat (i1 true), i32 8)
; CHECK-NEXT:  Cost Model: Found an estimated cost of 2 for instruction: call void @llvm.experimental.vp.strided.store.v16f32.p0.i32(<16 x float> %l16f, ptr align 4 %p, i32 -4, <16 x i1> splat (i1 true), i32 16)
; CHECK-NEXT:  Cost Model: Found an estimated cost of 0 for instruction: ret void
;
  %l8 = call <8 x i32> @llvm.experimental.vp.strided.load.v8i32.p0.i32(ptr align 4 %p, i32 %s, <8 x i1> splat (i1 true), i32 8)
  %l16f = call <16 x float> @llvm.experimental.vp.strided.load.v16f32.p0.i32(ptr align 4 %p, i32 %s, <16 x i1> splat (i1 true), i32 16)
  %l4 = call <4 x i32> @llvm.experimental.vp.strided.load.v4i32.p0.i32(ptr align 4 %p, i32 %s, <4 x i1> splat (i1 true), i32 4)
  call void @llvm.experimental.vp.strided.store.v8i32.p0.i32(<8 x i32> %l8, ptr align 4 %p, i32 %s, <8 x i1> splat (i1 true), i32 8)
  call void @llvm.experimental.vp.strided.store.v16f32.p0.i32(<16 x float> %l16f, ptr align 4 %p, i32 -4, <16 x i1> splat (i1 true), i32 16)
  ret void
}
