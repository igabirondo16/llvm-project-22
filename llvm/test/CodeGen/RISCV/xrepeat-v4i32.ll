  %s4 = mul <4 x i32> %v4, %s5
  %s3 = mul <4 x i32> %v3, %s4
  %s2 = mul <4 x i32> %v2, %s3
  %s1 = mul <4 x i32> %v1, %s2
  %s0 = mul <4 x i32> %v0, %s1
  store <4 x i32> %s0, ptr %d
  ret void
}

