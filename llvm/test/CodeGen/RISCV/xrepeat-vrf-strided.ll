; CHECK-NEXT:    xr.repeat 7, zero, 7
; CHECK-NEXT:    li a0, 4
; CHECK-NEXT:    fsw ft0, 0(a1)
; CHECK-NEXT:    xr.repeat 4, a0, 7
; CHECK-NEXT:    ret
  %w = load <64 x i32>, ptr %p, align 4
  %f1 = shufflevector <64 x i32> %w, <64 x i32> poison, <8 x i32> <i32 1, i32 9, i32 17, i32 25, i32 33, i32 41, i32 49, i32 57>
  %f6 = shufflevector <64 x i32> %w, <64 x i32> poison, <8 x i32> <i32 6, i32 14, i32 22, i32 30, i32 38, i32 46, i32 54, i32 62>
  %r = add <8 x i32> %f1, %f6
  store <8 x i32> %r, ptr %out
  ret void
}

; Interleaved store, factor 2: one strided fsw + REPEAT per field.
define void @istore2f(ptr %a, ptr %b, ptr %out) {
; CHECK-LABEL: istore2f:
; CHECK:       # %bb.0:
; CHECK-NEXT:    li a3, 4
; CHECK-NEXT:    flw ft0, 0(a0)
; CHECK-NEXT:    xr.repeat 1, a3, 7
; CHECK-NEXT:    li a0, 8
; CHECK-NEXT:    flw fs8, 0(a1)
; CHECK-NEXT:    xr.repeat 1, a3, 7
; CHECK-NEXT:    fsw ft0, 0(a2)
; CHECK-NEXT:    xr.repeat 4, a0, 7
; CHECK-NEXT:    fsw fs8, 4(a2)
; CHECK-NEXT:    xr.repeat 4, a0, 7
; CHECK-NEXT:    ret
  %va = load <8 x float>, ptr %a
  %vb = load <8 x float>, ptr %b
  %i = shufflevector <8 x float> %va, <8 x float> %vb, <16 x i32> <i32 0, i32 8, i32 1, i32 9, i32 2, i32 10, i32 3, i32 11, i32 4, i32 12, i32 5, i32 13, i32 6, i32 14, i32 7, i32 15>
  store <16 x float> %i, ptr %out, align 4
  ret void
}

