; CHECK:       # %bb.0:
; CHECK-NEXT:    li a2, 32
; CHECK-NEXT:    flw ft0, 24(a0)
; CHECK-NEXT:    xr.repeat 1, a2, 7
; CHECK-NEXT:    flw fs8, 4(a0)
; CHECK-NEXT:    xr.repeat 1, a2, 7
