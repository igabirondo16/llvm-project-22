}

define i32 @sload8_dot(ptr %p, ptr %q, i32 %acc) {
; CHECK-LABEL: sload8_dot:
; CHECK:       # %bb.0:
; CHECK-NEXT:    li a3, -4
; CHECK-NEXT:    flw ft0, 0(a0)
; CHECK-NEXT:    xr.repeat 1, a3, 7
; CHECK-NEXT:    li a0, 4
; CHECK-NEXT:    flw fs8, 0(a1)
; CHECK-NEXT:    xr.repeat 1, a0, 7
; CHECK-NEXT:    xr.mv.vx fa5, zero
; CHECK-NEXT:    xr.mac fa5, ft0, fs8, fa5
; CHECK-NEXT:    xr.repeat 6, zero, 7
; CHECK-NEXT:    xr.mv.xv a0, fa5
; CHECK-NEXT:    add a0, a0, a2
; CHECK-NEXT:    ret
  %a = call <8 x i32> @llvm.experimental.vp.strided.load.v8i32.p0.i32(ptr align 4 %p, i32 -4, <8 x i1> splat (i1 true), i32 8)
  %b = load <8 x i32>, ptr %q
  %m = mul <8 x i32> %a, %b
