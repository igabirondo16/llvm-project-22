; RUN: llc -mtriple=riscv32 -mattr=+m,+xrepeat -target-abi=ilp32 \
; RUN:   -verify-machineinstrs < %s | FileCheck %s

; XRepeat (VRF core): strided loads and stores are flw/fsw + REPEAT with the
; stride in a register (the REPEATed address advances by it for loads and
; stores alike), whether they come from llvm.experimental.vp.strided.* (SLP)
; or from an interleave group (the interleaved access pass turns each field
; into a strided access). A splat stored with a stride is one fixed register
; (mask 0000).

define void @sload8(ptr %p, i32 %s, ptr %out) {
; CHECK-LABEL: sload8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    flw ft0, 0(a0)
; CHECK-NEXT:    xr.repeat 1, a1, 7
; CHECK-NEXT:    li a0, 4
; CHECK-NEXT:    fsw ft0, 0(a2)
; CHECK-NEXT:    xr.repeat 4, a0, 7
; CHECK-NEXT:    ret
  %v = call <8 x i32> @llvm.experimental.vp.strided.load.v8i32.p0.i32(ptr align 4 %p, i32 %s, <8 x i1> splat (i1 true), i32 8)
  store <8 x i32> %v, ptr %out
  ret void
}

