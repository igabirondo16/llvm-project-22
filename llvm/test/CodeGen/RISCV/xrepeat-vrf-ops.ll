; The running sum is also used in the loop (stored every iteration): not
; rewritten, the sum goes through an x register.
define i32 @loop_isum_used(ptr %x, ptr %y, i32 %n) {
; CHECK-LABEL: loop_isum_used:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    mv a3, a0
; CHECK-NEXT:    li a0, 0
; CHECK-NEXT:    li a4, 4
; CHECK-NEXT:    xr.mv.vx fa5, zero
; CHECK-NEXT:  .LBB29_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    flw ft0, 0(a3)
; CHECK-NEXT:    xr.repeat 1, a4, 7
; CHECK-NEXT:    fmv.s fa4, fa5
; CHECK-NEXT:    addi a2, a2, -1
; CHECK-NEXT:    xr.add fa4, fa4, ft0
; CHECK-NEXT:    xr.repeat 4, zero, 7
; CHECK-NEXT:    xr.mv.xv a5, fa4
; CHECK-NEXT:    add a0, a0, a5
; CHECK-NEXT:    sw a0, 0(a1)
; CHECK-NEXT:    addi a1, a1, 4
; CHECK-NEXT:    addi a3, a3, 32
; CHECK-NEXT:    bnez a2, .LBB29_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %acc1, %loop ]
