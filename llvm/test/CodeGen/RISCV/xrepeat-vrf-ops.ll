; An ordered sum of products whose fmul and reduction are both `contract` (as
; the loop vectorizer makes them from llvm.fmuladd for XRepeat): one fused
; fmadd.s + REPEAT into the accumulator (mask 0110).
define float @fdot_contract(<8 x float> %a, <8 x float> %b, float %s) {
; CHECK-LABEL: fdot_contract:
; CHECK:       # %bb.0:
; CHECK-NEXT:    flw ft0, 0(sp)
; CHECK-NEXT:    fmv.w.x fs8, a0
; CHECK-NEXT:    flw ft1, 4(sp)
; CHECK-NEXT:    fmv.w.x fs9, a1
; CHECK-NEXT:    flw ft2, 8(sp)
; CHECK-NEXT:    fmv.w.x fs10, a2
; CHECK-NEXT:    flw ft3, 12(sp)
; CHECK-NEXT:    fmv.w.x fs11, a3
; CHECK-NEXT:    flw ft4, 16(sp)
; CHECK-NEXT:    fmv.w.x ft8, a4
; CHECK-NEXT:    flw ft5, 20(sp)
; CHECK-NEXT:    flw ft6, 24(sp)
; CHECK-NEXT:    flw ft7, 28(sp)
; CHECK-NEXT:    flw fa5, 32(sp)
; CHECK-NEXT:    fmv.w.x ft9, a5
; CHECK-NEXT:    fmv.w.x ft10, a6
; CHECK-NEXT:    fmv.w.x ft11, a7
; CHECK-NEXT:    fmadd.s fa5, fs8, ft0, fa5
; CHECK-NEXT:    xr.repeat 6, zero, 7
; CHECK-NEXT:    fmv.x.w a0, fa5
; CHECK-NEXT:    ret
  %m = fmul contract <8 x float> %a, %b
  %r = call contract float @llvm.vector.reduce.fadd.v8f32(float %s, <8 x float> %m)
  ret float %r
}

; 16 wide with a splat factor: only the vector walks (mask 0010).
define float @fdot_contract16s(<16 x float> %a, float %k, float %s) {
; CHECK-LABEL: fdot_contract16s:
; CHECK:       # %bb.0:
; CHECK-NEXT:    fmv.w.x ft0, a0
; CHECK-NEXT:    flw fa6, 36(sp)
; CHECK-NEXT:    fmv.w.x ft1, a1
; CHECK-NEXT:    fmv.w.x ft2, a2
; CHECK-NEXT:    fmv.w.x ft3, a3
; CHECK-NEXT:    fmv.w.x ft4, a4
; CHECK-NEXT:    fmv.w.x ft5, a5
; CHECK-NEXT:    fmv.w.x ft6, a6
; CHECK-NEXT:    fmv.w.x ft7, a7
; CHECK-NEXT:    flw fs0, 0(sp)
; CHECK-NEXT:    flw fs1, 4(sp)
; CHECK-NEXT:    flw fa0, 8(sp)
; CHECK-NEXT:    flw fa1, 12(sp)
; CHECK-NEXT:    flw fa2, 16(sp)
; CHECK-NEXT:    flw fa3, 20(sp)
; CHECK-NEXT:    flw fa4, 24(sp)
; CHECK-NEXT:    flw fa5, 28(sp)
; CHECK-NEXT:    flw fa7, 32(sp)
; CHECK-NEXT:    fmadd.s fa6, ft0, fa7, fa6
; CHECK-NEXT:    xr.repeat 2, zero, 15
; CHECK-NEXT:    fmv.x.w a0, fa6
; CHECK-NEXT:    ret
  %h = insertelement <16 x float> poison, float %k, i32 0
  %sp = shufflevector <16 x float> %h, <16 x float> poison, <16 x i32> zeroinitializer
  %m = fmul contract <16 x float> %a, %sp
  %r = call contract float @llvm.vector.reduce.fadd.v16f32(float %s, <16 x float> %m)
  ret float %r
}

; Without `contract` the products are rounded first: fmul.s, then fadd.s.
define float @fdot_nocontract(<8 x float> %a, <8 x float> %b, float %s) {
; CHECK-LABEL: fdot_nocontract:
; CHECK:       # %bb.0:
; CHECK-NEXT:    flw ft0, 0(sp)
; CHECK-NEXT:    fmv.w.x fs8, a0
; CHECK-NEXT:    flw ft1, 4(sp)
; CHECK-NEXT:    fmv.w.x fs9, a1
; CHECK-NEXT:    flw ft2, 8(sp)
; CHECK-NEXT:    fmv.w.x fs10, a2
; CHECK-NEXT:    flw ft3, 12(sp)
; CHECK-NEXT:    fmv.w.x fs11, a3
; CHECK-NEXT:    flw ft4, 16(sp)
; CHECK-NEXT:    fmv.w.x ft8, a4
; CHECK-NEXT:    flw ft5, 20(sp)
; CHECK-NEXT:    flw ft6, 24(sp)
; CHECK-NEXT:    flw ft7, 28(sp)
; CHECK-NEXT:    fmv.w.x ft9, a5
; CHECK-NEXT:    flw fa5, 32(sp)
; CHECK-NEXT:    fmv.w.x ft10, a6
; CHECK-NEXT:    fmv.w.x ft11, a7
; CHECK-NEXT:    fmul.s ft0, fs8, ft0
; CHECK-NEXT:    xr.repeat 7, zero, 7
; CHECK-NEXT:    fadd.s fa5, fa5, ft0
; CHECK-NEXT:    xr.repeat 4, zero, 7
; CHECK-NEXT:    fmv.x.w a0, fa5
; CHECK-NEXT:    ret
  %m = fmul <8 x float> %a, %b
  %r = call float @llvm.vector.reduce.fadd.v8f32(float %s, <8 x float> %m)
  ret float %r
}

; acc + reduce(a0*b0 + a1*b1) (SLP's 16-product reduction as two 8-wide
; halves): a chain of xr.mac + REPEAT into one f register, starting from acc,
; each block loaded next to its MAC (two blocks live, not four).
define i32 @red_sum_of_products(ptr %a, ptr %b, i32 %acc) {
; CHECK-LABEL: red_sum_of_products:
; CHECK:       # %bb.0:
; CHECK-NEXT:    fmv.w.x fa5, a2
; CHECK-NEXT:    li a2, 4
; CHECK-NEXT:    flw ft0, 0(a0)
; CHECK-NEXT:    xr.repeat 1, a2, 7
; CHECK-NEXT:    flw fs8, 0(a1)
; CHECK-NEXT:    xr.repeat 1, a2, 7
; CHECK-NEXT:    xr.mac fa5, ft0, fs8, fa5
; CHECK-NEXT:    xr.repeat 6, zero, 7
; CHECK-NEXT:    flw ft0, 32(a0)
; CHECK-NEXT:    xr.repeat 1, a2, 7
; CHECK-NEXT:    flw fs8, 32(a1)
; CHECK-NEXT:    xr.repeat 1, a2, 7
; CHECK-NEXT:    xr.mac fa5, ft0, fs8, fa5
; CHECK-NEXT:    xr.repeat 6, zero, 7
; CHECK-NEXT:    fmv.x.w a0, fa5
; CHECK-NEXT:    ret
  %pa1 = getelementptr inbounds i8, ptr %a, i32 32
  %pb1 = getelementptr inbounds i8, ptr %b, i32 32
  %a0 = load <8 x i32>, ptr %a
  %a1 = load <8 x i32>, ptr %pa1
  %b0 = load <8 x i32>, ptr %b
  %b1 = load <8 x i32>, ptr %pb1
  %m0 = mul <8 x i32> %a0, %b0
  %m1 = mul <8 x i32> %a1, %b1
  %s = add <8 x i32> %m0, %m1
  %r = call i32 @llvm.vector.reduce.add.v8i32(<8 x i32> %s)
  %res = add i32 %acc, %r
  ret i32 %res
}

; The same in a loop: the accumulator stays in its f register throughout.
define i32 @loop_red_sum_of_products(ptr %a, ptr %b, i32 %n) {
; CHECK-LABEL: loop_red_sum_of_products:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    addi a1, a1, 32
; CHECK-NEXT:    addi a0, a0, 32
; CHECK-NEXT:    fmv.w.x fa5, zero
; CHECK-NEXT:    li a3, 4
; CHECK-NEXT:  .LBB34_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    flw ft0, -32(a0)
; CHECK-NEXT:    xr.repeat 1, a3, 7
; CHECK-NEXT:    flw fs8, -32(a1)
; CHECK-NEXT:    xr.repeat 1, a3, 7
; CHECK-NEXT:    xr.mac fa5, ft0, fs8, fa5
; CHECK-NEXT:    xr.repeat 6, zero, 7
; CHECK-NEXT:    flw ft0, 0(a0)
; CHECK-NEXT:    xr.repeat 1, a3, 7
; CHECK-NEXT:    flw fs8, 0(a1)
; CHECK-NEXT:    xr.repeat 1, a3, 7
; CHECK-NEXT:    xr.mac fa5, ft0, fs8, fa5
; CHECK-NEXT:    xr.repeat 6, zero, 7
; CHECK-NEXT:    addi a2, a2, -1
; CHECK-NEXT:    addi a1, a1, 64
; CHECK-NEXT:    addi a0, a0, 64
; CHECK-NEXT:    bnez a2, .LBB34_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    fmv.x.w a0, fa5
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %acc1, %loop ]
  %pa0 = getelementptr inbounds <16 x i32>, ptr %a, i32 %i
  %pb0 = getelementptr inbounds <16 x i32>, ptr %b, i32 %i
  %pa1 = getelementptr inbounds i8, ptr %pa0, i32 32
  %pb1 = getelementptr inbounds i8, ptr %pb0, i32 32
  %a0 = load <8 x i32>, ptr %pa0
  %a1 = load <8 x i32>, ptr %pa1
  %b0 = load <8 x i32>, ptr %pb0
  %b1 = load <8 x i32>, ptr %pb1
  %m0 = mul <8 x i32> %a0, %b0
  %m1 = mul <8 x i32> %a1, %b1
  %s = add <8 x i32> %m0, %m1
  %r = call i32 @llvm.vector.reduce.add.v8i32(<8 x i32> %s)
  %acc1 = add i32 %acc, %r
  %i1 = add i32 %i, 1
  %c = icmp eq i32 %i1, %n
  br i1 %c, label %exit, label %loop
exit:
  ret i32 %acc1
}

; A chain of reduction loops (each loop's sum starts the next one, as in
; resnet8's convolutions): both accumulators stay in f registers.
define i32 @chained_loops(ptr %a, ptr %b, i32 %n) {
; CHECK-LABEL: chained_loops:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    fmv.w.x fa5, zero
; CHECK-NEXT:    li a3, 4
; CHECK-NEXT:    mv a4, a2
; CHECK-NEXT:  .LBB35_1: # %l1
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    flw ft0, 0(a0)
; CHECK-NEXT:    xr.repeat 1, a3, 7
; CHECK-NEXT:    addi a4, a4, -1
; CHECK-NEXT:    xr.add fa5, fa5, ft0
; CHECK-NEXT:    xr.repeat 4, zero, 7
; CHECK-NEXT:    addi a0, a0, 32
; CHECK-NEXT:    bnez a4, .LBB35_1
; CHECK-NEXT:  # %bb.2: # %mid
; CHECK-NEXT:    li a0, 4
; CHECK-NEXT:  .LBB35_3: # %l2
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    flw ft0, 0(a1)
; CHECK-NEXT:    xr.repeat 1, a0, 7
; CHECK-NEXT:    addi a2, a2, -1
; CHECK-NEXT:    xr.add fa5, fa5, ft0
; CHECK-NEXT:    xr.repeat 4, zero, 7
; CHECK-NEXT:    addi a1, a1, 32
; CHECK-NEXT:    bnez a2, .LBB35_3
; CHECK-NEXT:  # %bb.4: # %exit
; CHECK-NEXT:    fmv.x.w a0, fa5
; CHECK-NEXT:    ret
entry:
  br label %l1
l1:
  %i = phi i32 [ 0, %entry ], [ %i1, %l1 ]
  %acc = phi i32 [ 0, %entry ], [ %acc1, %l1 ]
  %pa = getelementptr inbounds <8 x i32>, ptr %a, i32 %i
  %va = load <8 x i32>, ptr %pa
  %r = call i32 @llvm.vector.reduce.add.v8i32(<8 x i32> %va)
  %acc1 = add i32 %acc, %r
  %i1 = add i32 %i, 1
  %c = icmp eq i32 %i1, %n
  br i1 %c, label %mid, label %l1
mid:
  br label %l2
l2:
  %j = phi i32 [ 0, %mid ], [ %j1, %l2 ]
  %acc2 = phi i32 [ %acc1, %mid ], [ %acc3, %l2 ]
  %pb = getelementptr inbounds <8 x i32>, ptr %b, i32 %j
  %vb = load <8 x i32>, ptr %pb
  %r2 = call i32 @llvm.vector.reduce.add.v8i32(<8 x i32> %vb)
  %acc3 = add i32 %acc2, %r2
  %j1 = add i32 %j, 1
  %c2 = icmp eq i32 %j1, %n
  br i1 %c2, label %exit, label %l2
exit:
  ret i32 %acc3
}
