  %a = load <8 x float>, ptr %p
  %r = call float @llvm.vector.reduce.fadd.v8f32(float %s, <8 x float> %a)
  ret float %r
}
define i32 @dot8(ptr %p, ptr %q) {
; CHECK-LABEL: dot8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    li a2, 4
; CHECK-NEXT:    flw ft0, 0(a0)
; CHECK-NEXT:    xr.repeat 1, a2, 7
; CHECK-NEXT:    flw fs8, 0(a1)
; CHECK-NEXT:    xr.repeat 1, a2, 7
; CHECK-NEXT:    xr.mv.vx fa5, zero
; CHECK-NEXT:    xr.mac fa5, ft0, fs8, fa5
; CHECK-NEXT:    xr.repeat 6, zero, 7
; CHECK-NEXT:    xr.mv.xv a0, fa5
; CHECK-NEXT:    ret
  %a = load <8 x i32>, ptr %p
  %b = load <8 x i32>, ptr %q
  %m = mul <8 x i32> %a, %b
  %r = call i32 @llvm.vector.reduce.add.v8i32(<8 x i32> %m)
  ret i32 %r
}
define i32 @dot16s(ptr %p, i32 %s) {
; CHECK-LABEL: dot16s:
; CHECK:       # %bb.0:
; CHECK-NEXT:    fmv.w.x fa5, a1
; CHECK-NEXT:    li a1, 4
; CHECK-NEXT:    flw fa6, 0(a0)
; CHECK-NEXT:    xr.repeat 1, a1, 15
; CHECK-NEXT:    xr.mv.vx fa4, zero
; CHECK-NEXT:    xr.mac fa4, fa6, fa5, fa4
; CHECK-NEXT:    xr.repeat 2, zero, 15
; CHECK-NEXT:    xr.mv.xv a0, fa4
; CHECK-NEXT:    ret
  %a = load <16 x i32>, ptr %p
  %h = insertelement <16 x i32> poison, i32 %s, i32 0
  %sp = shufflevector <16 x i32> %h, <16 x i32> poison, <16 x i32> zeroinitializer
  %m = mul <16 x i32> %a, %sp
  %r = call i32 @llvm.vector.reduce.add.v16i32(<16 x i32> %m)
  ret i32 %r
}

; The accumulator coalesced into an element of the summed block (start value
; v[3]): the sum is done in a free F register and copied back.
define float @accclash(ptr %p) {
; CHECK-LABEL: accclash:
; CHECK:       # %bb.0:
; CHECK-NEXT:    li a1, 4
; CHECK-NEXT:    flw ft0, 0(a0)
; CHECK-NEXT:    xr.repeat 1, a1, 7
; CHECK-NEXT:    fmv.s fa5, ft3
; CHECK-NEXT:    fadd.s fa5, fa5, ft0
; CHECK-NEXT:    xr.repeat 4, zero, 7
; CHECK-NEXT:    fmv.s ft3, fa5
; CHECK-NEXT:    fmv.x.w a0, ft3
; CHECK-NEXT:    ret
  %a = load <8 x float>, ptr %p
  %e = extractelement <8 x float> %a, i32 3
  %r = call float @llvm.vector.reduce.fadd.v8f32(float %e, <8 x float> %a)
  ret float %r
}

; A splat hoisted out of the loop is sunk next to its user
; (isProfitableToSinkOperands): a fixed F register, not a block.
define void @hoisted_splat(ptr %x, i32 %s, i32 %n) {
; CHECK-LABEL: hoisted_splat:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    li a3, 4
; CHECK-NEXT:    fmv.w.x fa5, a1
; CHECK-NEXT:    xr.mv.vx fa4, zero
; CHECK-NEXT:  .LBB24_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    flw ft0, 0(a0)
; CHECK-NEXT:    xr.repeat 1, a3, 7
; CHECK-NEXT:    addi a2, a2, -1
; CHECK-NEXT:    xr.mac ft0, ft0, fa5, fa4
; CHECK-NEXT:    xr.repeat 3, zero, 7
; CHECK-NEXT:    fsw ft0, 0(a0)
; CHECK-NEXT:    xr.repeat 4, a3, 7
; CHECK-NEXT:    addi a0, a0, 32
; CHECK-NEXT:    bnez a2, .LBB24_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    ret
entry:
  %h = insertelement <8 x i32> poison, i32 %s, i32 0
  %sp = shufflevector <8 x i32> %h, <8 x i32> poison, <8 x i32> zeroinitializer
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %p = getelementptr inbounds <8 x i32>, ptr %x, i32 %i
  %v = load <8 x i32>, ptr %p
  %m = mul <8 x i32> %v, %sp
  store <8 x i32> %m, ptr %p
  %i1 = add i32 %i, 1
  %c = icmp eq i32 %i1, %n
  br i1 %c, label %exit, label %loop
exit:
  ret void
}

; An ordered float reduction in a loop keeps a scalar accumulator (not RVV's
; vector phi, see RISCVCodeGenPrepare).
define float @loop_fsum(ptr %x, i32 %n) {
; CHECK-LABEL: loop_fsum:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    fmv.w.x fa5, zero
; CHECK-NEXT:    li a2, 4
; CHECK-NEXT:  .LBB25_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    flw fa6, 0(a0)
; CHECK-NEXT:    xr.repeat 1, a2, 15
; CHECK-NEXT:    addi a1, a1, -1
; CHECK-NEXT:    fadd.s fa5, fa5, fa6
; CHECK-NEXT:    xr.repeat 4, zero, 15
; CHECK-NEXT:    addi a0, a0, 64
; CHECK-NEXT:    bnez a1, .LBB25_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    fmv.x.w a0, fa5
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %acc = phi float [ 0.0, %entry ], [ %acc1, %loop ]
  %p = getelementptr inbounds <16 x float>, ptr %x, i32 %i
  %v = load <16 x float>, ptr %p
  %acc1 = call float @llvm.vector.reduce.fadd.v16f32(float %acc, <16 x float> %v)
  %i1 = add i32 %i, 1
  %c = icmp eq i32 %i1, %n
  br i1 %c, label %exit, label %loop
exit:
  ret float %acc1
}

; An i32 sum in a loop: RISCVCodeGenPrepare makes the accumulator a float phi,
; so it stays in its f register and xr.add accumulates straight into it.
define i32 @loop_isum(ptr %x, i32 %n) {
; CHECK-LABEL: loop_isum:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    li a2, 5
; CHECK-NEXT:    fmv.w.x fa5, a2
; CHECK-NEXT:    li a2, 4
; CHECK-NEXT:  .LBB26_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    flw ft0, 0(a0)
; CHECK-NEXT:    xr.repeat 1, a2, 7
; CHECK-NEXT:    addi a1, a1, -1
; CHECK-NEXT:    xr.add fa5, fa5, ft0
; CHECK-NEXT:    xr.repeat 4, zero, 7
; CHECK-NEXT:    addi a0, a0, 32
; CHECK-NEXT:    bnez a1, .LBB26_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    fmv.x.w a0, fa5
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %acc = phi i32 [ 5, %entry ], [ %acc1, %loop ]
  %p = getelementptr inbounds <8 x i32>, ptr %x, i32 %i
  %v = load <8 x i32>, ptr %p
  %r = call i32 @llvm.vector.reduce.add.v8i32(<8 x i32> %v)
  %acc1 = add i32 %acc, %r
  %i1 = add i32 %i, 1
  %c = icmp eq i32 %i1, %n
  br i1 %c, label %exit, label %loop
exit:
  ret i32 %acc1
}

; A dot product in a loop: one xr.mac + REPEAT (mask 0110) into the f register
; accumulator; the result is stored straight from it.
define void @loop_dot(ptr %a, ptr %b, ptr %out, i32 %n) {
; CHECK-LABEL: loop_dot:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    fmv.w.x fa5, zero
; CHECK-NEXT:    li a4, 4
; CHECK-NEXT:  .LBB27_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    flw ft0, 0(a0)
; CHECK-NEXT:    xr.repeat 1, a4, 7
; CHECK-NEXT:    flw fs8, 0(a1)
; CHECK-NEXT:    xr.repeat 1, a4, 7
; CHECK-NEXT:    addi a3, a3, -1
; CHECK-NEXT:    addi a1, a1, 32
; CHECK-NEXT:    xr.mac fa5, ft0, fs8, fa5
; CHECK-NEXT:    xr.repeat 6, zero, 7
; CHECK-NEXT:    addi a0, a0, 32
; CHECK-NEXT:    bnez a3, .LBB27_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    fsw fa5, 0(a2)
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %acc1, %loop ]
  %pa = getelementptr inbounds <8 x i32>, ptr %a, i32 %i
  %va = load <8 x i32>, ptr %pa
  %pb = getelementptr inbounds <8 x i32>, ptr %b, i32 %i
  %vb = load <8 x i32>, ptr %pb
  %m = mul <8 x i32> %va, %vb
  %r = call i32 @llvm.vector.reduce.add.v8i32(<8 x i32> %m)
  %acc1 = add i32 %r, %acc
  %i1 = add i32 %i, 1
  %c = icmp eq i32 %i1, %n
  br i1 %c, label %exit, label %loop
exit:
  %lcssa = phi i32 [ %acc1, %loop ]
  store i32 %lcssa, ptr %out
  ret void
}

; 16 wide.
define i32 @loop_isum16(ptr %x, i32 %n) {
; CHECK-LABEL: loop_isum16:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    fmv.w.x fa5, zero
; CHECK-NEXT:    li a2, 4
; CHECK-NEXT:  .LBB28_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
