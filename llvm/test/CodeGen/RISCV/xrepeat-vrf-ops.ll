  store <8 x float> %r, ptr %x
  ret void
}

; Reductions accumulate into one F register, the block walking (mask 0100), in
; element order (so an ordered float sum is exact); i32 results move back to
; an x register. A dot product is one xr.mac (mask 0110).
define i32 @r8(ptr %p) {
; CHECK-LABEL: r8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    li a1, 4
; CHECK-NEXT:    flw ft0, 0(a0)
; CHECK-NEXT:    xr.repeat 1, a1, 7
; CHECK-NEXT:    xr.mv.vx fa5, zero
; CHECK-NEXT:    xr.add fa5, fa5, ft0
; CHECK-NEXT:    xr.repeat 4, zero, 7
; CHECK-NEXT:    xr.mv.xv a0, fa5
; CHECK-NEXT:    ret
  %a = load <8 x i32>, ptr %p
  %r = call i32 @llvm.vector.reduce.add.v8i32(<8 x i32> %a)
  ret i32 %r
}
define i32 @r16(ptr %p) {
; CHECK-LABEL: r16:
; CHECK:       # %bb.0:
; CHECK-NEXT:    li a1, 4
; CHECK-NEXT:    flw ft0, 0(a0)
; CHECK-NEXT:    xr.repeat 1, a1, 15
; CHECK-NEXT:    xr.mv.vx fa6, zero
; CHECK-NEXT:    xr.add fa6, fa6, ft0
; CHECK-NEXT:    xr.repeat 4, zero, 15
; CHECK-NEXT:    xr.mv.xv a0, fa6
; CHECK-NEXT:    ret
  %a = load <16 x i32>, ptr %p
  %r = call i32 @llvm.vector.reduce.add.v16i32(<16 x i32> %a)
  ret i32 %r
}
define float @f8(ptr %p) {
; CHECK-LABEL: f8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    li a1, 4
; CHECK-NEXT:    flw ft0, 0(a0)
; CHECK-NEXT:    xr.repeat 1, a1, 7
; CHECK-NEXT:    fmv.w.x fa5, zero
; CHECK-NEXT:    fadd.s fa5, fa5, ft0
; CHECK-NEXT:    xr.repeat 4, zero, 7
; CHECK-NEXT:    fmv.x.w a0, fa5
; CHECK-NEXT:    ret
  %a = load <8 x float>, ptr %p
  %r = call reassoc float @llvm.vector.reduce.fadd.v8f32(float 0.0, <8 x float> %a)
  ret float %r
}
define float @f8o(ptr %p, float %s) {
; CHECK-LABEL: f8o:
; CHECK:       # %bb.0:
; CHECK-NEXT:    fmv.w.x fa5, a1
; CHECK-NEXT:    li a1, 4
; CHECK-NEXT:    flw ft0, 0(a0)
; CHECK-NEXT:    xr.repeat 1, a1, 7
