; XRepeat (VRF core): fmin.s/fmax.s + REPEAT for minnum/maxnum and
; minimumnum/maximumnum. Mask bit 0 = rd, 1 = rs1, 2 = rs2 walks.

; Vector and vector: everything walks (0111).
define void @max_vv(ptr %a, ptr %b, ptr %c) {
; CHECK-LABEL: max_vv:
; CHECK:       # %bb.0:
; CHECK-NEXT:    li a3, 4
; CHECK-NEXT:    flw ft0, 0(a0)
; CHECK-NEXT:    xr.repeat 1, a3, 7
; CHECK-NEXT:    flw fs8, 0(a1)
; CHECK-NEXT:    xr.repeat 1, a3, 7
; CHECK-NEXT:    fmax.s ft0, ft0, fs8
; CHECK-NEXT:    xr.repeat 7, zero, 7
; CHECK-NEXT:    fsw ft0, 0(a2)
; CHECK-NEXT:    xr.repeat 4, a3, 7
; CHECK-NEXT:    ret
  %x = load <8 x float>, ptr %a
  %y = load <8 x float>, ptr %b
  %r = call <8 x float> @llvm.maxnum.v8f32(<8 x float> %x, <8 x float> %y)
  store <8 x float> %r, ptr %c
  ret void
}

; Vector and a constant splat: rs2 is one register (0011).
define void @relu(ptr %a, ptr %c) {
; CHECK-LABEL: relu:
; CHECK:       # %bb.0:
; CHECK-NEXT:    li a2, 4
; CHECK-NEXT:    flw ft0, 0(a0)
; CHECK-NEXT:    xr.repeat 1, a2, 7
; CHECK-NEXT:    fmv.w.x fa5, zero
; CHECK-NEXT:    fmax.s ft0, ft0, fa5
; CHECK-NEXT:    xr.repeat 3, zero, 7
; CHECK-NEXT:    fsw ft0, 0(a1)
; CHECK-NEXT:    xr.repeat 4, a2, 7
; CHECK-NEXT:    ret
  %x = load <8 x float>, ptr %a
  %r = call <8 x float> @llvm.maximumnum.v8f32(<8 x float> %x, <8 x float> zeroinitializer)
  store <8 x float> %r, ptr %c
  ret void
}

