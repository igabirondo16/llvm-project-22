; 16 wide, a clamp: a constant bound, then a splat of an argument as rs1
; (0101).
define void @clamp16(ptr %a, ptr %c, float %lo) {
; CHECK-LABEL: clamp16:
; CHECK:       # %bb.0:
; CHECK-NEXT:    fmv.w.x fa6, a2
; CHECK-NEXT:    li a2, 4
; CHECK-NEXT:    flw ft0, 0(a0)
; CHECK-NEXT:    xr.repeat 1, a2, 15
; CHECK-NEXT:    lui a0, 274400
; CHECK-NEXT:    fmv.w.x fa7, a0
; CHECK-NEXT:    fmin.s ft0, ft0, fa7
; CHECK-NEXT:    xr.repeat 3, zero, 15
; CHECK-NEXT:    fmax.s ft0, fa6, ft0
; CHECK-NEXT:    xr.repeat 5, zero, 15
; CHECK-NEXT:    fsw ft0, 0(a1)
; CHECK-NEXT:    xr.repeat 4, a2, 15
; CHECK-NEXT:    ret
  %x = load <16 x float>, ptr %a
  %h = insertelement <16 x float> poison, float %lo, i32 0
  %s = shufflevector <16 x float> %h, <16 x float> poison, <16 x i32> zeroinitializer
  %m = call <16 x float> @llvm.minimumnum.v16f32(<16 x float> %x, <16 x float> splat (float 127.0))
  %r = call <16 x float> @llvm.maxnum.v16f32(<16 x float> %s, <16 x float> %m)
  store <16 x float> %r, ptr %c
  ret void
}
