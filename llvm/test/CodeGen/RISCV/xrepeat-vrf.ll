; CHECK-NEXT:    sw a2, 20(a0)
; CHECK-NEXT:    sw a1, 24(a0)
; CHECK-NEXT:    sw zero, 28(a0)
; CHECK-NEXT:    ret
  store i32 -1, ptr %p
  %p1 = getelementptr i32, ptr %p, i32 1
  store i32 0, ptr %p1
  %p2 = getelementptr i32, ptr %p, i32 2
  store i32 1, ptr %p2
  %p3 = getelementptr i32, ptr %p, i32 3
  store i32 -1, ptr %p3
  %p4 = getelementptr i32, ptr %p, i32 4
  store i32 0, ptr %p4
  %p5 = getelementptr i32, ptr %p, i32 5
