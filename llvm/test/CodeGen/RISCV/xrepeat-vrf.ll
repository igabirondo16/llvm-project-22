; Consecutive scalar stores are not merged into a vector store (building the
; vector in F registers would cost more than the stores it replaces).
define void @no_store_merge(ptr %p) {
; CHECK-LABEL: no_store_merge:
; CHECK:       # %bb.0:
; CHECK-NEXT:    li a1, -1
; CHECK-NEXT:    li a2, 1
; CHECK-NEXT:    sw a1, 0(a0)
