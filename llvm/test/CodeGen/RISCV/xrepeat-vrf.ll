; CHECK-NEXT:    li a2, 4
; CHECK-NEXT:    flw ft0, 0(a0)
; CHECK-NEXT:    xr.repeat 1, a2, 7
; CHECK-NEXT:    fsw ft0, 0(a1)
; CHECK-NEXT:    xr.repeat 4, a2, 7
; CHECK-NEXT:    ret
  %v = load <8 x i32>, ptr %a
  store <8 x i32> %v, ptr %b
  ret void
}
