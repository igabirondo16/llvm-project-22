define void @swap(ptr %a, ptr %b, ptr %out, i32 %n) {
; CHECK-LABEL: swap:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    li a4, 4
; CHECK-NEXT:    flw fs8, 0(a0)
; CHECK-NEXT:    xr.repeat 1, a4, 7
; CHECK-NEXT:    flw ft0, 0(a1)
; CHECK-NEXT:    xr.repeat 1, a4, 7
; CHECK-NEXT:    li a0, 0
; CHECK-NEXT:  .LBB7_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    addi a0, a0, 1
; CHECK-NEXT:    xr.addi fa6, ft0, 0
; CHECK-NEXT:    xr.repeat 3, zero, 7
; CHECK-NEXT:    xr.addi ft0, fs8, 0
; CHECK-NEXT:    xr.repeat 3, zero, 7
; CHECK-NEXT:    xr.addi fs8, fa6, 0
; CHECK-NEXT:    xr.repeat 3, zero, 7
; CHECK-NEXT:    blt a0, a3, .LBB7_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    li a0, 4
; CHECK-NEXT:    fsw ft0, 0(a2)
; CHECK-NEXT:    xr.repeat 4, a0, 7
; CHECK-NEXT:    fsw fa6, 32(a2)
; CHECK-NEXT:    xr.repeat 4, a0, 7
; CHECK-NEXT:    ret
entry:
  %x0 = load <8 x float>, ptr %a
  %y0 = load <8 x float>, ptr %b
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %x = phi <8 x float> [ %x0, %entry ], [ %y, %loop ]
  %y = phi <8 x float> [ %y0, %entry ], [ %x, %loop ]
  %i1 = add i32 %i, 1
  %c = icmp slt i32 %i1, %n
  br i1 %c, label %loop, label %exit
exit:
  store <8 x float> %x, ptr %out
  %o2 = getelementptr i8, ptr %out, i32 32
  store <8 x float> %y, ptr %o2
  ret void
}

